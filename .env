SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=qazisanaullah612@gmail.com
SMTP_PASSWORD=gemr zptx nnaa wrom
FROM_EMAIL=qazisanaullah612@gmail.com
FROM_NAME=LeaveFlow

# CORS Configuration
