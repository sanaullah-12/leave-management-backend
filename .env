NODE_ENV=development
PORT=5000
# Set to true to make the LOCAL server use the live Atlas data.
# WARNING: writes affect real production records.
# NOTE: keep NODE_ENV=development here even though this connects to the real
# Atlas DB. NODE_ENV=production changes other behavior too (email link
# generation skips FRONTEND_URL_DEV, error responses hide details, etc.), and
# FRONTEND_URL below is intentionally the LOCAL frontend — mixing the two
# previously caused invite/reset emails sent from a local server to embed a
# http://localhost link, which is unusable for any real recipient.
USE_PRODUCTION_DB=false
MONGODB_URI=mongodb+srv://qazisanaullah612_db_user:Uo9n6mtsevaGf1JY@cluster0.3ouqpxd.mongodb.net/leave-management?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=lms_prod_jwt_2024_secure_key_change_in_production_deployment_v1.0
JWT_EXPIRE=7d

# Email configuration for invitations/notifications
# Local development sends over Gmail SMTP; Brevo is production-only and its API
# key is never distributed to developer machines. Production ignores this value
# and always uses Brevo.
