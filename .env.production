# COMMITTED FILE - must never contain secrets. Secrets live in Railway -> Variables.
# PRODUCTION ENVIRONMENT VARIABLES
NODE_ENV=production 
PORT=5000

# PRODUCTION DATABASE - MongoDB Atlas
# MONGODB_URI is a SECRET: set it in Railway -> Variables only (least-privilege Atlas user).
# MONGODB_URI=

# JWT Configuration - Generate new secure secrets for production
# JWT_SECRET is a SECRET: set it in Railway -> Variables only. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production with a short, placeholder or leaked value.
# JWT_SECRET=
# Access tokens last ACCESS_TOKEN_TTL (default 15m); sessions SESSION_IDLE_DAYS / SESSION_MAX_DAYS.
# Public self-service company sign-up is off in production unless ALLOW_COMPANY_REGISTRATION=true.

# Frontend URL - Vercel deployment URL
FRONTEND_URL=https://leave-management-frontend-neon.vercel.app

# ---------------------------------------------------------------------------
# Email — Brevo (HTTPS API, official @getbrevo/brevo SDK)
# ---------------------------------------------------------------------------
# BREVO_API_KEY is a SECRET — set it in the Railway dashboard only, never here.
#   Railway → service → Variables → BREVO_API_KEY = xkeysib-...
# Create a v3 API key at https://app.brevo.com/settings/keys/api
# (an SMTP key will NOT work — it must be an API key.)
#
# EMAIL_FROM must be a VERIFIED sender in Brevo, otherwise every send is
# rejected. Verify it at https://app.brevo.com/senders (Brevo emails a
# confirmation link to the address), or verify the whole domain at
# https://app.brevo.com/senders/domain and use any address on it.
EMAIL_FROM=qazisanaullah612@gmail.com
EMAIL_FROM_NAME=Nexora

# CORS Configuration
ALLOWED_ORIGINS=https://leave-management-frontend-neon.vercel.app,https://leave-management-frontend-2j4tks98j.vercel.app
CORS_ORIGIN=https://leave-management-frontend-neon.vercel.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100