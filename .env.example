NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/leave-management
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Frontend base URL — used to build links inside emails.
# If this is wrong, emails send successfully but contain unusable links.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email — Brevo (HTTPS API, official @getbrevo/brevo SDK)
# ---------------------------------------------------------------------------
# 1. Create a v3 API key: https://app.brevo.com/settings/keys/api
#    It starts with "xkeysib-". An SMTP key will NOT work here.
#    Never commit a real key — set it in Railway → Variables for production.
BREVO_API_KEY=xkeysib-your_api_key_here

# 2. EMAIL_FROM must be a VERIFIED sender in Brevo or sends are rejected:
#    - single address: https://app.brevo.com/senders (confirm via emailed link)
#    - whole domain:   https://app.brevo.com/senders/domain
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=Nexora

# Optional
EMAIL_REPLY_TO=support@yourdomain.com
