NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/leave-management
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Frontend base URL — used to build links inside emails.
# If this is wrong, emails send successfully but contain unusable links.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email — Resend (HTTPS API, official SDK)
# ---------------------------------------------------------------------------
# Get an API key at https://resend.com/api-keys (keys start with "re_").
# Never commit a real key — set it in Railway → Variables for production.
RESEND_API_KEY=re_your_api_key_here

# THE sender. This is the ONLY value to change when your domain is verified:
#   testing:    Nexora <onboarding@resend.dev>
#   production: Nexora <no-reply@yourdomain.com>
#
# onboarding@resend.dev is Resend's shared test sender — it ONLY delivers to
# the address that owns the Resend account. To email real recipients, verify a
# domain at https://resend.com/domains and change EMAIL_FROM to an address on it.
EMAIL_FROM=Nexora <onboarding@resend.dev>

# Optional
EMAIL_REPLY_TO=support@yourdomain.com
