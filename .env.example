NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/leave-management
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Frontend base URL — used to build links inside emails.
# If this is wrong, emails send successfully but contain unusable links.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email — Brevo (HTTPS API, official @getbrevo/brevo SDK)
# ---------------------------------------------------------------------------
# 1. Create a v3 API key: https://app.brevo.com/settings/keys/api
#    It starts with "xkeysib-". An SMTP key will NOT work here.
#    Never commit a real key — set it in Railway → Variables for production.
BREVO_API_KEY=xkeysib-your_api_key_here

# 2. EMAIL_FROM must be a VERIFIED sender in Brevo or sends are rejected:
#    - single address: https://app.brevo.com/senders (confirm via emailed link)
#    - whole domain:   https://app.brevo.com/senders/domain
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=Nexora

# Optional
EMAIL_REPLY_TO=support@yourdomain.com

# ---------------------------------------------------------------------------
# WhatsApp notifications
# ---------------------------------------------------------------------------
# The WhatsApp channel runs alongside the in-app/Socket.IO one. Everything here
# is optional: with WHATSAPP_ENABLED unset, in-app notifications are unaffected
# and no WhatsApp message is ever attempted.
# Full reference: docs/WHATSAPP_NOTIFICATION_ARCHITECTURE.md
WHATSAPP_ENABLED=false

# Which driver sends the message: meta | twilio | log
# "log" prints the rendered message to stdout instead of sending it. It is the
# default on purpose - an unconfigured environment can never message real
# employees. Use it for local development and CI.
WHATSAPP_PROVIDER=log

# -- Meta WhatsApp Cloud API (WHATSAPP_PROVIDER=meta) ------------------------
# Both values come from Meta Business Manager > WhatsApp > API Setup.
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_API_VERSION=v21.0

# Meta only delivers free-form text inside the 24-hour window that opens when a
# user last messaged your business. HRMS notifications are business-initiated,
# so production must use pre-approved templates: register the template names
# listed in notifications/NotificationTemplates.js, then set this to true.
# Leaving it false in production means messages are accepted and never arrive.
WHATSAPP_USE_APPROVED_TEMPLATES=false
WHATSAPP_TEMPLATE_LANGUAGE=en

# -- Twilio WhatsApp (WHATSAPP_PROVIDER=twilio) ------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Plain E.164; the "whatsapp:" prefix is added for you.
TWILIO_WHATSAPP_FROM=+14155238886

# -- Delivery behaviour ------------------------------------------------------
WHATSAPP_TIMEOUT_MS=10000

# Safety valve for staging: send every WhatsApp message to this number instead
# of the real recipient. Leave empty in production.
WHATSAPP_REDIRECT_ALL_TO=

# Accept local numbers ("03001234567") and store them as E.164 by prepending
# this country code. Leave empty to require the full international format -
# guessing a country from a bare local number can message a stranger.
PHONE_DEFAULT_COUNTRY_CODE=

# -- Queue -------------------------------------------------------------------
NOTIFICATION_QUEUE_CONCURRENCY=4
NOTIFICATION_QUEUE_MAX_ATTEMPTS=3
NOTIFICATION_QUEUE_BASE_DELAY_MS=2000
NOTIFICATION_QUEUE_MAX_DELAY_MS=60000
NOTIFICATION_QUEUE_MAX_SIZE=5000

# -- Recipients --------------------------------------------------------------
# Roles that receive "back office" notifications (new leave request, new Voice).
# The system ships with a single `admin` role; the day an HR role exists, add it
# here - no code change. Recipients are always resolved from the database.
NOTIFICATION_ADMIN_ROLES=admin

# -- Logging -----------------------------------------------------------------
# error | warn | info | debug
NOTIFICATION_LOG_LEVEL=info
# Phone numbers are masked in logs unless this is turned on while debugging.
NOTIFICATION_LOG_FULL_PHONES=false
NOTIFICATION_PRODUCT_NAME=Nexora HRMS
